{
  "run": [{
    "method": "shell.run",
    "params": {
      "message": "{{os.platform() === 'win32' ? '' : 'brew install mecab'}}"
    }
  },
  {
    "method": "shell.run",
    "params": {
      "venv": "env",
      "venv_python": "3.11",
      "message": [
        "uv pip install gradio==4.44.0 pydantic==2.10.6",
        "uv pip install -r requirements.txt"
      ]
    }
  },
  {
    "method": "script.start",
    "params": {
      "uri": "torch.js",
      "params": {
        "venv": "env"
      }
    }
  },
  {
    "method": "notify",
    "params": { "html": "Click the 'start' tab to get started!" }
  }]
}
